graph TD
    A["读取当前状态"] --> B["当前层要不要停"]
    B --> C{"停靠条件成立吗"}
    C -->|是| D["开门 / 上下客 / 清除请求"]
    C -->|否| E["保持运行"]
    D --> F["判断前方还有没有需求"]
    E --> F
    F -->|有| G["保持当前方向"]
    F -->|没有| H["反向或待机"]
    G --> A
    H --> A

    style A fill:#bbdefb,stroke:#333,color:#000
    style D fill:#c8e6c9,stroke:#333,color:#000
    style F fill:#ffccbc,stroke:#333,color:#000
    style H fill:#fff9c4,stroke:#333,color:#000
